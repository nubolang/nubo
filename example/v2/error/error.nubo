let site = _callsite()
println(site)
let location = SourceLocation(site.file, site.line, site.column, site.columnEnd)

let root = Error("Root cause")
let base = Error("Base error", root, location)
let error = Error("An error occurred", base, location)

println(error)

let circular = Error("Circular cause")
circular.base = circular

println(circular)
