fn add(left: int, right: int) int
{
    return left + right
}

let result = add(
    2,
    3
)
expect(result == 5, "calls should allow arguments on separate lines")

let named = add(
    left: 4,
    right: 5,
)
expect(named == 9, "multiline calls should support named arguments and a trailing comma")

let nested = add(
    add(
        1,
        2
    ),
    3
)
expect(nested == 6, "multiline calls should support nested calls")

fn seven() int
{
    return 7
}

expect(seven(
) == 7, "empty multiline calls should have no arguments")

let value = 0

if result == 5
{
    value = 1
}
else if result == 6
{
    value = 2
}
else
{
    value = 3
}
expect(value == 1, "if should allow its opening brace on the next line")

if false
{
    value = 4
}
else
{
    value = 5
}
expect(value == 5, "else should allow its opening brace on the next line")

return true
